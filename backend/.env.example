# ==============================================================================
# Honda Bikes Store — Backend Environment Configuration
# NOTE: This file is an example template with placeholders only.
# Copy this file to '.env' and populate with your local values.
# NEVER commit real credentials or production secrets to source control.
# ==============================================================================

# Server Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port
PORT=5000

# Database Connection String (Placeholder only)
# Format: mysql://username:password@localhost:3306/honda_bikes_store
DATABASE_URL=mysql://root:local_password_here@localhost:3306/honda_bikes_store

# Database Connection Pool Maximum Connections
DB_POOL_MAX=10

# JWT Authentication Secret (Must be >= 32 characters in production)
JWT_SECRET=replace_this_with_a_secure_random_key_of_at_least_32_characters

# JWT Expiry Duration (e.g. 2h, 1d)
JWT_EXPIRES_IN=2h

# Cookie Name for Auth Session
COOKIE_NAME=honda_auth_token

# Cookie Secure Flag (true in production / HTTPS, false in local development)
COOKIE_SECURE=false

# Allowed Origins for CORS (Comma-separated list)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Standard Delivery Charge in PKR (Optional: leave empty to mark as "confirmed before dispatch")
DELIVERY_CHARGE_PKR=

# Order Constraints
MAX_ITEMS_PER_ORDER=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10
ORDER_RATE_LIMIT_MAX_REQUESTS=5
